# -----------------------------------------------------------------------------
# Multi-provider AI gateway
# -----------------------------------------------------------------------------
# Declare one or more OpenAI-compatible providers as a JSON array.
# Priority is ascending: a LOWER number is tried FIRST. When a provider fails
# (network error, timeout, 429, 5xx) the gateway automatically fails over to
# the next one. Keys are server-only and never exposed to the browser.
#
# !! MUST BE A SINGLE LINE !!
# Next.js reads each .env line as KEY=value, so a multi-line (pretty-printed)
# JSON array gets truncated at the first newline and fails to parse. Always put
# the whole array on ONE line. This applies to Vercel/Netlify dashboards too —
# paste it as a single line.
#
# IMPORTANT (cloud deploys, e.g. Vercel/Netlify): endpoints must be PUBLICLY
# reachable. A local router like http://localhost:20128/v1 will NOT work in the
# cloud — use a public provider (e.g. 9router cloud, OpenRouter) instead.
#
# Ready-to-use example (single line) — uncomment and fill in your keys:
# OPENAI_PROVIDERS=[{"id":"9router","baseURL":"https://api.9router.com/v1","apiKey":"sk-...","model":"bansos","priority":1},{"id":"openrouter","baseURL":"https://openrouter.ai/api/v1","apiKey":"sk-or-...","model":"openai/gpt-4o-mini","priority":2}]
#
# Optional fields per provider:
#   "enabled": false                      -> temporarily disable without removing
#   "extraHeaders": {"HTTP-Referer":"https://yourapp.com","X-Title":"Threvo"}
OPENAI_PROVIDERS=

# --- Legacy single-provider config (fallback) --------------------------------
# Used automatically when OPENAI_PROVIDERS is empty or invalid. Handy for local
# development with a single endpoint (e.g. http://localhost:20128/v1).
OPENAI_API_ENDPOINT=https://...
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL_NAME=model-ai

# --- Generation limits --------------------------------------------------------
# Max output tokens per AI request. Suggested-topic requests now ask for up to
# 30 topics in a single call (buffered to serve many "shuffle" clicks), which
# produces longer JSON than a normal thread. If you see topics getting
# truncated, raise this (e.g. 6000). Defaults to 4000 when unset.
AI_MAX_TOKENS=4000

# --- Rate limiting ------------------------------------------------------------
# Which proxy header carries the real client IP. Leave empty unless the app sits
# behind a proxy that OVERWRITES the header; otherwise clients can spoof the IP
# per request and defeat the rate limiter.
# Accepted values: cf-connecting-ip | x-real-ip | x-vercel-forwarded-for
# Examples: Cloudflare -> cf-connecting-ip ; Vercel -> x-vercel-forwarded-for
TRUSTED_IP_HEADER=

# Branding
NEXT_PUBLIC_APP_NAME=Threvo
NEXT_PUBLIC_APP_TAGLINE=Turn your thoughts into threads.
NEXT_PUBLIC_APP_DESCRIPTION=Threvo turns your ideas into threads and posts you can edit before you post them.
NEXT_PUBLIC_APP_SHORT_DESCRIPTION=A simple way to turn ideas into great threads.

# Storage
NEXT_PUBLIC_MAX_THREADS_STORAGE=100

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL and anon key: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only, NEVER expose to browser):
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database password, used only by `npm run db:push` (Supabase CLI).
# Supabase Dashboard → Project Settings → Database → Database password.
# Not read by the app at runtime.
SUPABASE_DB_PASSWORD=your-database-password

# 32-byte base64 key for encrypting Threads access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# -----------------------------------------------------------------------------
# Threads (Meta) OAuth
# -----------------------------------------------------------------------------
# Create a Threads app at https://developers.facebook.com, add the Threads API
# product, and request the threads_basic + threads_content_publish permissions.
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret

# Must match EXACTLY the redirect URI registered in the Meta app, e.g.
# dev:  http://localhost:3000/api/threads/callback
# prod: https://your-worker.workers.dev/api/threads/callback
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/callback
